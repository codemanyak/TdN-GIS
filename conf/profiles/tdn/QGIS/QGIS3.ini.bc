[plugins]
MemoryLayerSaver\MemoryLayerSaver\memoryLayerSaveSetting=true
MemoryLayerSaver\MemoryLayerSaver\mldataEmbedded=false
automatically-check-for-updates=true
searchPathsForPlugins=@Invalid()

[proxy]
authcfg=
noProxyUrls=@Invalid()
proxyEnabled=false
proxyHost=
proxyPassword=
proxyPort=
proxyType=DefaultProxy
proxyUser=

[pythonConsole]
accessTokenGithub=
autoCloseBracket=false
autoCompThreshold=2
autoCompleteEnabled=true
autoCompleteSource=fromAPI
autoInsertImport=false
autoInsertionImport=true
autoSaveScript=false
autoSurround=true
enableObjectInsp=false
formatOnSave=false
preloadAPI=true
preparedAPIFile=
splitterConsole=@ByteArray(\0\0\0\xff\0\0\0\x1\0\0\0\x2\0\0\0\xab\0\0\0\x9f\0\0\0\0\x3\x1\0\0\0\x2\0)
splitterEditor=@ByteArray(\0\0\0\xff\0\0\0\x1\0\0\0\x2\0\0\x1\0\0\0\0\0\x1\0\0\0\x6\x1\0\0\0\x1\0)
splitterObj=@ByteArray(\0\0\0\xff\0\0\0\x1\0\0\0\x2\0\0\0\0\0\0\0\x46\x1\0\0\0\x3\x1\0\0\0\x1\0)
usePreparedAPIFile=false
userAPI=@Invalid()

[qgis]
askToDeleteLayers=false
askToSaveProjectChanges=true
attributeForm\defaultGroupColumnCount=1
attributeForm\defaultTabColumnCount=1
attributeTableBehavior=ShowAll

recent\generic="if(maximum(\"folge\" ) is null,1, maximum(\"folge\" + 1))", " \"infrastruktur\"  =  'Zufahrtsadresse' ", " if(  \"infrastruktur\" ='Zufahrtsadresse',\n\tadr_osm('plz') ||' '||\tadr_osm('cit') ||' '||adr_osm('add'),\n\t\"addr_eintragen\")", "overlay_nearest('Punkte',\n\t\t\t \"name\"\n\t\t\t )[0]", " overlay_nearest('Punkte',\n\t\t\t\t\texpression:= \"name\")[0]", "substr( \"etappe\" ,1,6) ||'_' || \"nutzer\" ||'_' ||@id", " \"steigung_proz\"  <= 1", round(\n\t((\"hoehe_max\" - \"hoehe_min\") / $length) * 100\n\t), \"hoehe_max\" - \"hoehe_min\", round($length), \"hoehe_min\", \"hoehe_max\", fid, " \"hoehe\" %4 = 0", " adr_osm('str')", " is_selected() and \"typ\"  in ( '1 Quartier' , '2 Mittag' , '3 Aktion' ) and  \"status\"  =  '3 Best\xe4tigt' ", " is_selected()", " \"etappe\" = 14 and \"typ\"  in ( '1 Quartier' , '2 Mittag' , '3 Aktion' ) and  \"status\"  =  '3 Best\xe4tigt' ", "collect_geometries (\n array_remove_all( \narray_sort(\n    array_foreach (\n        aggregate( \n             @knoten, --'knoten', \n            'array_agg', \n            $geometry\n        ),\n        extend (\n            make_line(\n                line_interpolate_point( \n                    $geometry,\n                    line_locate_point($geometry,@element)\n                ),\n            project (\n                 line_interpolate_point( \n                    $geometry,\n                    line_locate_point($geometry,@element)\n                ),\n                0.2,\n                radians(\n                    90+line_interpolate_angle( \n                        $geometry,\n                        line_locate_point($geometry,@element)\n            )))),\n            0.2,\n            0\n)\n)\n),NULL\n)\n)", "\nif(\"start_zeit\" is  NULL,\n\n to_string( \nwith_variable('tm',\n(\n( (hour( format_date(minimum(\"start_zeit\") ,'hh:mm')) * 60) +  minute(format_date( minimum(\"start_zeit\")  ,'hh:mm')))  +   \n\n\t\t\t(( to_real( coalesce(\"lauf_km\",0)) /  @km_h ) * 60)\n\t),\nfloor(@tm / 60)  ||':' || round( ((@tm / 60) -floor(@tm / 60) ) * 60 )\n)\t\n)\n,\n\"start_zeit\" \n--to_string(( (hour( format_date(\"start_zeit\" ,'hh:mm')) * 60) +  minute(format_date(\"start_zeit\"  ,'hh:mm'))))\n\n)\n\n--)\n\n--@startzeit"
recent\selection=" \"aktiv\" = 1", " \"start_zeit\" like  '19%' "


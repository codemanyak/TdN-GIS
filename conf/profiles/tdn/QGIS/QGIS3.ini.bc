[core]
Layout\searchPathsForTemplates=@Invalid()
NewsFeed\httpsfeedqgisorg\49\content="<p>A message of peace from the QGIS Community: We, the developers, contributors and community members of the QGIS Project view the ongoing world events in Ukraine and other conflict areas around the world with great sadness. Our aim in developing QGIS has always been to provide a powerful tool to support the creation of a just and humane society. We want to enable a world where every person has a voice, the ability to express, and be secure in, their tenure in their homes, villages, towns, cities and countries.&nbsp;We hope tools like QGIS are used to the benefit of all citizens on earth, to support a sustainable environment, an orderly society and, in particular, to establish and preserve sovereign dignity, security and freedom from oppression.</p>\r\n<p>We ask the leaders of the world to resolve their disputes peacefully, through negotiation and compromise, humility and deference to the citizens who are placed in your care. To the members of the QGIS Community that are caught up in this conflict, our thoughts and support are with you, and we hope that you and your families are safe and that this conflict comes to a speedy end.</p>"
NewsFeed\httpsfeedqgisorg\49\imageUrl=https://feed.qgis.org/media/feedimages/2022/02/25/Flag_of_Ukraine.jpg
NewsFeed\httpsfeedqgisorg\49\link=@Variant(\0\0\0\x11\0\0\0Thttps://www.qgis.org/en/site/getinvolved/governance/codeofconduct/codeofconduct.html)
NewsFeed\httpsfeedqgisorg\49\sticky=false
NewsFeed\httpsfeedqgisorg\49\title=QGIS for Peace
NewsFeed\httpsfeedqgisorg\64\content="<p>OpenStreetMap (OSM) is free to use, but not free to run. The QGIS user experience is tremendously improved thanks to OSM data, tiles, geocoding, and other services. OSM depends on donations from people like you! <strong>Double-click</strong> this entry to learn how to support OSM's continued stability, quality, and independence.</p>"
NewsFeed\httpsfeedqgisorg\64\expiry=@DateTime(\0\0\0\x10\0\0\0\0\0\0%\x8b\xd1\x3\xb5\xc0\xb8\0)
NewsFeed\httpsfeedqgisorg\64\imageUrl=https://feed.qgis.org/media/feedimages/2023/11/08/osm-funding.jpg
NewsFeed\httpsfeedqgisorg\64\link=@Variant(\0\0\0\x11\0\0\0$https://supporting.openstreetmap.org)
NewsFeed\httpsfeedqgisorg\64\sticky=false
NewsFeed\httpsfeedqgisorg\64\title=It\x2019s OSM\x2019s Birthday! Please donate to support its future.
NewsFeed\httpsfeedqgisorg\65\content="<p>The Cyber Resilience Act will, by design, place considerable strain on the Open Source Geospatial Foundation and the service providers who power so much of our ecosystem. The OSGeo community has been active during this process lending their voice of concern, feedback, and moral objection (not everything is a product!) and support. We encourage you to get informed and lend your voice of support to ensure that these laws do not jeopardise or impact projects like QGIS. <strong>Double-click this entry to learn more.</strong></p>"
NewsFeed\httpsfeedqgisorg\65\expiry=@DateTime(\0\0\0\x10\0\0\0\0\0\0%\x8b\xd1\x3\xba\xe1\x38\0)
NewsFeed\httpsfeedqgisorg\65\imageUrl=https://feed.qgis.org/media/feedimages/2023/11/09/europe.jpg
NewsFeed\httpsfeedqgisorg\65\link=@Variant(\0\0\0\x11\0\0\0>https://www.osgeo.org/foundation-news/eu-cyber-resilience-act/)
NewsFeed\httpsfeedqgisorg\65\sticky=false
NewsFeed\httpsfeedqgisorg\65\title=OSGeo Statement: EU Cyber Resilience Act
NewsFeed\httpsfeedqgisorg\72\content="<p>The QGIS User Conference '24 is an international 2-day event on September 9 and 10, 2024 in Bratislava, Slovakia.&nbsp; There will be presentations and workshops to get your QGIS knowledge up to date. There will also be space for \"unconference\" type of meetings, where you can bring your own topics for discussions or workshops and find people who are interested.</p>"
NewsFeed\httpsfeedqgisorg\72\expiry=@DateTime(\0\0\0\x10\0\0\0\0\0\0%\x8b\x93\x3\x1\x41\xb0\0)
NewsFeed\httpsfeedqgisorg\72\imageUrl=https://feed.qgis.org/media/feedimages/2024/02/21/logotype_qgis_uc_2024.jpg
NewsFeed\httpsfeedqgisorg\72\link=@Variant(\0\0\0\x11\0\0\0\x17https://uc2024.qgis.sk/)
NewsFeed\httpsfeedqgisorg\72\sticky=false
NewsFeed\httpsfeedqgisorg\72\title=Join the QGIS User Conference 2024
NewsFeed\httpsfeedqgisorg\disabled=false

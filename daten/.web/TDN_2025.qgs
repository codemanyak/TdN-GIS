              <default field="quartiertyp" applyOnUpdate="0" expression="'7 Keines'"/>
              <default field="quartier_beschreibung" applyOnUpdate="0" expression="''"/>
              <default field="anzahl_dusche" applyOnUpdate="0" expression="0"/>
              <default field="anzahl_klo" applyOnUpdate="0" expression="1"/>
              <default field="zelt" applyOnUpdate="0" expression=""/>
              <default field="ab_raeume" applyOnUpdate="0" expression="0"/>
              <default field="telefon" applyOnUpdate="0" expression="0"/>
              <default field="internet" applyOnUpdate="0" expression="0"/>
              <default field="status" applyOnUpdate="1" expression="case&#xa;when  &quot;typ&quot; in ( '1 Quartier' , '2 Mittag' , '3 Aktion' ) then &quot;status&quot;&#xa;when &quot;typ&quot; in (  '4 Überhol' ,  '5 Stop' ) then '5 STOP-Überhol'&#xa;when &quot;typ&quot; =  '6 POI' then '4 POI'&#xa;end"/>
              <default field="kosten" applyOnUpdate="0" expression="0"/>
              <default field="kosten_beschr" applyOnUpdate="0" expression="''"/>
              <default field="bedingungen" applyOnUpdate="0" expression="''"/>
              <default field="aktion_typ" applyOnUpdate="0" expression=""/>

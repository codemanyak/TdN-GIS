      <defaults>
        <default field="fid" applyOnUpdate="0" expression=""/>
        <default field="name" applyOnUpdate="1" expression=" concat(&quot;etappe&quot; ,&#xa;&#x9;&#x9;&#x9; (if(  &quot;typ&quot; = '4 Sonder' ,' S: ','')),&#xa;&#x9;&#x9;&#x9;( if(&quot;etappen_segment&quot; is not NULL,('/' ||&quot;etappen_segment&quot;),'') ) ,&#xa;&#x9;&#x9;&#x9;': ', &quot;start_punkt&quot; ,&#xa;&#x9;&#x9;&#x9;' => ' ||  &quot;ziel_punkt&quot; &#xa;&#x9;&#x9;&#x9;)"/>
        <default field="etappe" applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'nr')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;"/>
        <default field="etappen_bezeichnung" applyOnUpdate="0" expression=""/>
        <default field="etappen_name" applyOnUpdate="1" expression="if( &quot;etappe&quot; = 2,  &quot;name&quot; ,&#xa;with_variable('ob',&#xa;&#x9; get_feature( 'TagesStrecken', 'bezeichnung' ,&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;attribute(@feature,'etappen_bezeichnung' )&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;),&#xa;concat(&#xa;&#x9; &quot;etappe&quot; , ': ' ,&#xa;&#x9;attribute(@ob,'start_punkt' ) , ' => ' ,&#xa;&#x9;attribute(@ob,'ziel_punkt' ) &#xa;&#x9;)&#xa;&#x9;)&#xa;&#x9;)"/>
        <default field="datum" applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'datum')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;"/>
        <default field="wochentag" applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'wochentag')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;"/>
        <default field="etappen_segment" applyOnUpdate="1" expression="with_variable('ms',maximum(&quot;etappen_segment&quot; ,group_by:=  &quot;etappe&quot; ||  &quot;sonder&quot; ),&#xa;Case &#xa;&#xa;&#x9;when regexp_substr(&quot;fid&quot; ,'[a-z]') = '' then &quot;etappen_segment&quot;&#xa;&#x9;when  &quot;etapen_typ&quot; =  '1 Start'  then 1&#xa;&#x9;when @ms is not NULL &#xa;&#x9;&#x9;and &quot;etappen_segment&quot; = 1&#xa;&#x9;&#x9;then @ms  + 1&#xa;&#x9;when @ms is NULL then  1&#xa;&#x9;else @ms  + 1&#xa;&#x9;end&#xa;&#x9;&#x9;&#x9;&#x9;&#xa;&#x9;&#x9;&#x9;)"/>
        <default field="start_punkt" applyOnUpdate="0" expression=""/>
        <default field="ziel_punkt" applyOnUpdate="0" expression=""/>
        <default field="etapen_typ" applyOnUpdate="0" expression="NULL"/>
        <default field="strecke_km" applyOnUpdate="1" expression="round($length / 1000,3)"/>
        <default field="hut" applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'hut')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;"/>
        <default field="status" applyOnUpdate="0" expression="NULL"/>
        <default field="aufgaben" applyOnUpdate="0" expression="''"/>
        <default field="bemerkungen" applyOnUpdate="0" expression="''"/>
        <default field="bearb_von" applyOnUpdate="1" expression="attribute(&#xa;get_feature('Akteure','akt_us',&#xa;&#x9;&#x9;&#x9;1),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'name')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;"/>
        <default field="bearb_am" applyOnUpdate="1" expression="format_date(  now(),'yyyy-MM-dd')"/>
        <default field="sonder" applyOnUpdate="1" expression="if(  &quot;typ&quot; = '4 Sonder' ,1,0)"/>
        <default field="zeit" applyOnUpdate="0" expression=""/>
        <default field="aktion" applyOnUpdate="0" expression=""/>
        <default field="kmh_08_min" applyOnUpdate="1" expression="round(((($length / 1000 ) / 8) * 60))"/>
        <default field="kmh_10_min" applyOnUpdate="0" expression="round(((($length / 1000 ) / 10) * 60))"/>
        <default field="kmh_12_min" applyOnUpdate="1" expression="round(((($length / 1000 ) / 12) * 60))"/>
        <default field="kmh_15_min" applyOnUpdate="1" expression="round(((($length / 1000 ) / 15) * 60))"/>
      </defaults>

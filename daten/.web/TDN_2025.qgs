              <default field="name" applyOnUpdate="1" expression="if( &quot;name&quot; is NULL or &quot;name&quot; = '' ,&#xd;&#xa;case&#xd;&#xa;when  &quot;typ&quot; =  '5 Stop'  &#xd;&#xa;then &#xd;&#xa;&#x9;('S ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '5 Stop' ),0),0) +1) &#xd;&#xa;&#x9;&#x9;&#x9;) &#xd;&#xa;when&quot;typ&quot; =  '4 Überhol' &#xd;&#xa;then &#xd;&#xa;&#x9;('Ü ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '4 Überhol' ),0),0) +1)  &#xd;&#xa;&#x9;&#x9;&#x9;)&#xd;&#xa;&#xd;&#xa;else ''&#xd;&#xa;end,&#xd;&#xa;&quot;name&quot;&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;"/>
              <default field="bearbeitet_von" applyOnUpdate="1" expression="if( &quot;bearbeitet_von&quot;  is NULL or &quot;bearbeitet_von&quot; = '',&#xa;attribute(&#xa; get_feature( 'Akteure','akt_us','1'),&#xa; 'name')&#xa; , &quot;bearbeitet_von&quot; )"/>
              <default field="datum_aenderung" applyOnUpdate="0" expression=""/>
              <default field="hut" applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'hut')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;"/>
              <default field="etappen_bezeichnung" applyOnUpdate="0" expression=""/>
              <default field="etappe" applyOnUpdate="1" expression=" attribute(&#xa; get_feature('Etappen','bezeichnung', &quot;etappen_bezeichnung&quot; ),'nr')"/>
              <default field="etappen_name" applyOnUpdate="1" expression="attribute(&#x9;&#xa;&#x9; get_feature( 'StreckenPlan', 'etappen_bezeichnung' , &quot;etappen_bezeichnung&quot; ),&#xa;&#x9; 'etappen_name' )&#xa;"/>
              <default field="datum" applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'datum')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;"/>
              <default field="wochentag" applyOnUpdate="1" expression=" attribute(&#xa; get_feature('Etappen','bezeichnung', &quot;etappen_bezeichnung&quot; ),'wochentag')"/>
              <default field="quartiertyp" applyOnUpdate="0" expression="'7 Keines'"/>
              <default field="quartier_beschreibung" applyOnUpdate="0" expression="''"/>
              <default field="anzahl_dusche" applyOnUpdate="0" expression="0"/>
              <default field="anzahl_klo" applyOnUpdate="0" expression="1"/>
              <default field="zelt" applyOnUpdate="0" expression=""/>
              <default field="ab_raeume" applyOnUpdate="0" expression="0"/>
              <default field="telefon" applyOnUpdate="0" expression="0"/>
              <default field="internet" applyOnUpdate="0" expression="0"/>

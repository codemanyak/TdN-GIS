              <default field="abfahrt_tag" applyOnUpdate="1" expression="case&#xa;&#x9;when   &quot;typ&quot;  =  '1 Quartier' &#xa;&#x9;&#x9; then attribute( &#xa;&#x9;&#x9;&#x9;&#x9;get_feature( 'Etappen', 'nr' , &quot;etappe&quot; +  &quot;aufenthalt_tage&quot; ),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9; 'bezeichnung' &#xa;&#x9;&#x9;&#x9;&#x9;&#x9; )&#xa;&#x9;Else  &quot;etappen_bezeichnung&quot; &#xa;end"/>

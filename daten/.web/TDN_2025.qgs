        <rules key="{b2dcd2aa-77d6-4eea-adea-d771479daeae}">
          <rule label="Startpunkt" key="{85231d13-ed2f-406f-8b99-ca37d1cf161d}" symbol="0" checkstate="0"/>
          <rule label="Planung" filter=" &quot;status&quot; =  '1 Entwurf' --aggregate( 'Punkte',aggregate:= 'concatenate_unique',expression:= &quot;status&quot;,filter:=   &quot;name&quot; in ( attribute(@parent, 'start_punkt'),attribute(@parent,       'ziel_punkt')),concatenator:=',')  != '3 Bestätigt' or &quot;status&quot; != '3 Genehmigt' " key="{cd84d151-e3f1-4374-bc6b-64c70d150753}" symbol="1"/>
          <rule label="Fertig" filter=" &quot;status&quot;  =  '2 Festgelegt' -- (aggregate( 'Punkte',aggregate:= 'concatenate_unique',expression:= &quot;status&quot;,filter:=   &quot;name&quot;  in ( attribute(@parent, 'start_punkt'),attribute(@parent,  'ziel_punkt')),concatenator:=',')  = '3 Bestätigt') and  &quot;status&quot; =  '3 Genehmigt' " key="{9a3da083-bdf3-4297-8ac5-a1c3d437aa44}" symbol="2"/>
          <rule label="Genehmigt" filter=" &quot;status&quot;  =   '3 Genehmigt'  -- (aggregate( 'Punkte',aggregate:= 'concatenate_unique',expression:= &quot;status&quot;,filter:=   &quot;name&quot;  in ( attribute(@parent, 'start_punkt'),attribute(@parent,  'ziel_punkt')),concatenator:=',')  = '3 Bestätigt') and  &quot;status&quot; =  '3 Genehmigt' " key="{02d8bc2a-1fbc-45f4-9f93-9234eec313ea}" symbol="3"/>
          <rule key="{32356c5a-8130-4841-a4c6-d0b92836a3d5}" symbol="4" checkstate="0"/>

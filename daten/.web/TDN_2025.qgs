              <default field="poi_typ" applyOnUpdate="0" expression="'12 Sonstiges' "/>
              <default field="poi_beschreibung" applyOnUpdate="0" expression="''"/>
              <default field="adresse" applyOnUpdate="1" expression="if(&quot;adresse&quot; is NULL, &#xa;&#x9;&#x9;concat(adr_osm('add'), ', ' ,adr_osm('plz'), ' ' ,adr_osm('cit'))&#xa;&#x9;&#x9;, &quot;adresse&quot; &#xa;&#x9;&#x9;)"/>

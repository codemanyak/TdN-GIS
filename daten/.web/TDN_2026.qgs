          <rule key="{82aac8ac-84af-4f06-93b5-6dc73c36e22f}" label="Groß" scalemindenom="1" scalemaxdenom="25000">
            <rule filter=" &quot;oneway&quot; in ( 'yes' , 'reversible' , '-1' )" key="{9e490851-197b-4633-9c20-f40c7cc1a129}" symbol="0"/>

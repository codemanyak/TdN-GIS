            <defaults>
              <default applyOnUpdate="0" expression="" field="fid"/>
              <default applyOnUpdate="1" expression=" concat(&quot;etappe&quot; ,&#xa;&#x9;&#x9;&#x9; (if(  &quot;typ&quot; = '4 Sonder' ,' S: ','')),&#xa;&#x9;&#x9;&#x9;( if(&quot;etappen_segment&quot; is not NULL,('/' ||&quot;etappen_segment&quot;),'') ) ,&#xa;&#x9;&#x9;&#x9;': ', &quot;start_punkt&quot; ,&#xa;&#x9;&#x9;&#x9;' => ' ||  &quot;ziel_punkt&quot; &#xa;&#x9;&#x9;&#x9;)" field="name"/>
              <default applyOnUpdate="0" expression="" field="etappe"/>
              <default applyOnUpdate="0" expression="" field="etappen_bezeichnung"/>
              <default applyOnUpdate="1" expression="if( &quot;etappe&quot; = 2,  &quot;name&quot; ,&#xa;with_variable('ob',&#xa;&#x9; get_feature( 'TagesStrecken', 'bezeichnung' ,&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;attribute(@feature,'etappen_bezeichnung' )&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;),&#xa;concat(&#xa;&#x9; &quot;etappe&quot; , ': ' ,&#xa;&#x9;attribute(@ob,'start_punkt' ) , ' => ' ,&#xa;&#x9;attribute(@ob,'ziel_punkt' ) &#xa;&#x9;)&#xa;&#x9;)&#xa;&#x9;)" field="etappen_name"/>
              <default applyOnUpdate="0" expression="" field="datum"/>
              <default applyOnUpdate="0" expression="" field="wochentag"/>
              <default applyOnUpdate="1" expression="with_variable('ms',maximum(&quot;etappen_segment&quot; ,group_by:=  &quot;etappe&quot; ||  &quot;sonder&quot; ),&#xa;Case &#xa;&#xa;&#x9;when regexp_substr(&quot;fid&quot; ,'[a-z]') = '' then &quot;etappen_segment&quot;&#xa;&#x9;when  &quot;etapen_typ&quot; =  '1 Start'  then 1&#xa;&#x9;when @ms is not NULL &#xa;&#x9;&#x9;and &quot;etappen_segment&quot; = 1&#xa;&#x9;&#x9;then @ms  + 1&#xa;&#x9;when @ms is NULL then  1&#xa;&#x9;else @ms  + 1&#xa;&#x9;end&#xa;&#x9;&#x9;&#x9;&#x9;&#xa;&#x9;&#x9;&#x9;)" field="etappen_segment"/>
              <default applyOnUpdate="0" expression="" field="start_punkt"/>
              <default applyOnUpdate="0" expression="" field="ziel_punkt"/>
              <default applyOnUpdate="0" expression="NULL" field="etapen_typ"/>
              <default applyOnUpdate="1" expression="round($length / 1000,3)" field="strecke_km"/>
              <default applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'hut')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;" field="hut"/>
              <default applyOnUpdate="0" expression="NULL" field="status"/>
              <default applyOnUpdate="0" expression="''" field="aufgaben"/>
              <default applyOnUpdate="0" expression="''" field="bemerkungen"/>
              <default applyOnUpdate="0" expression="" field="bearb_von"/>
              <default applyOnUpdate="1" expression="format_date(  now(),'yyyy-MM-dd')" field="bearb_am"/>
              <default applyOnUpdate="1" expression="if(  &quot;typ&quot; = '4 Sonder' ,1,0)" field="sonder"/>
              <default applyOnUpdate="0" expression="" field="zeit"/>
              <default applyOnUpdate="0" expression="" field="aktion"/>
              <default applyOnUpdate="1" expression="round(((($length / 1000 ) / 8) * 60))" field="kmh_08_min"/>
              <default applyOnUpdate="0" expression="round(((($length / 1000 ) / 10) * 60))" field="kmh_10_min"/>
              <default applyOnUpdate="1" expression="round(((($length / 1000 ) / 12) * 60))" field="kmh_12_min"/>
              <default applyOnUpdate="1" expression="round(((($length / 1000 ) / 15) * 60))" field="kmh_15_min"/>
            </defaults>

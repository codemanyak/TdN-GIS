        <default applyOnUpdate="1" expression="&#xa;case&#xa;&#x9;when right( &quot;etappen_bezeichnung&quot; ,2) = right(&quot;abfahrt_tag&quot; ,2)&#xa;&#x9;then &#xa;&#x9;&#x9;&#x9;substr(right(&quot;abfahrt_tag&quot; ,5),1,2) &#xa;&#x9;&#x9;- substr(right(&quot;etappen_bezeichnung&quot; ,5),1,2) &#xa;&#x9;else &#xa;&#x9;   substr(right(&quot;abfahrt_tag&quot; ,5),1,2)  &#xa;&#x9;   + (31 - substr(right(&quot;etappen_bezeichnung&quot; ,5),1,2) )&#xa;end&#xa;&#x9;&#x9;&#xa;" field="aufenthalt_tage"/>
        <default applyOnUpdate="0" expression="" field="xxc"/>

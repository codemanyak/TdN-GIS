      <defaults>
        <default applyOnUpdate="0" expression="" field="fid"/>
        <default applyOnUpdate="0" expression="NULL" field="typ"/>
        <default applyOnUpdate="1" expression="if( &quot;name&quot; is NULL or &quot;name&quot; = '' ,&#xd;&#xa;case&#xd;&#xa;when  &quot;typ&quot; =  '5 Stop'  &#xd;&#xa;then &#xd;&#xa;&#x9;('S ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '5 Stop' ),0),0) +1) &#xd;&#xa;&#x9;&#x9;&#x9;) &#xd;&#xa;when&quot;typ&quot; =  '4 Überhol' &#xd;&#xa;then &#xd;&#xa;&#x9;('Ü ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '4 Überhol' ),0),0) +1)  &#xd;&#xa;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;&#xa;&#xa;when  &quot;typ&quot; in ( '1 Quartier' , '2 Mittag' , '3 Aktion' ) then adr_osm('cit') || ' **Bitte ergänzen***'&#xd;&#xa;&#xd;&#xa;else ''&#xd;&#xa;end,&#xd;&#xa;&quot;name&quot;&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;" field="name"/>
        <default applyOnUpdate="1" expression="if( &quot;bearbeitet_von&quot;  is NULL or &quot;bearbeitet_von&quot; = '',&#xa;attribute(&#xa; get_feature( 'Akteure','akt_us','1'),&#xa; 'name')&#xa; , &quot;bearbeitet_von&quot; )" field="bearbeitet_von"/>
        <default applyOnUpdate="0" expression="" field="datum_aenderung"/>
        <default applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'hut_quartier')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;" field="hut"/>
        <default applyOnUpdate="0" expression="" field="etappen_bezeichnung"/>
        <default applyOnUpdate="1" expression=" attribute(&#xa; get_feature('Etappen','bezeichnung', &quot;etappen_bezeichnung&quot; ),'etappe')" field="etappe"/>
        <default applyOnUpdate="1" expression="attribute(&#x9;&#xa;&#x9; get_feature( 'StreckenPlan', 'etappen_bezeichnung' , &quot;etappen_bezeichnung&quot; ),&#xa;&#x9; 'etappen_name' )&#xa;" field="etappen_name"/>
        <default applyOnUpdate="1" expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'datum')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;" field="datum"/>
        <default applyOnUpdate="1" expression=" attribute(&#xa; get_feature('Etappen','bezeichnung', &quot;etappen_bezeichnung&quot; ),'wochentag')" field="wochentag"/>
        <default applyOnUpdate="0" expression="'7 Keines'" field="quartiertyp"/>
        <default applyOnUpdate="0" expression="''" field="quartier_beschreibung"/>
        <default applyOnUpdate="0" expression="0" field="anzahl_dusche"/>
        <default applyOnUpdate="0" expression="1" field="anzahl_klo"/>
        <default applyOnUpdate="0" expression="" field="zelt"/>
        <default applyOnUpdate="0" expression="0" field="ab_raeume"/>
        <default applyOnUpdate="0" expression="0" field="telefon"/>
        <default applyOnUpdate="0" expression="0" field="internet"/>
        <default applyOnUpdate="1" expression="case&#xa;when  &quot;typ&quot; in ( '1 Quartier' , '2 Mittag' , '3 Aktion' ) then &quot;status&quot;&#xa;when &quot;typ&quot; in (  '4 Überhol' ,  '5 Stop' ) then '5 STOP-Überhol'&#xa;when &quot;typ&quot; =  '6 POI' then '4 POI'&#xa;end" field="status"/>
        <default applyOnUpdate="0" expression="0" field="kosten"/>
        <default applyOnUpdate="0" expression="''" field="kosten_beschr"/>
        <default applyOnUpdate="0" expression="''" field="bedingungen"/>
        <default applyOnUpdate="0" expression="" field="aktion_typ"/>
        <default applyOnUpdate="0" expression="''" field="aktion_beschreibung"/>
        <default applyOnUpdate="0" expression="'12 Sonstiges' " field="poi_typ"/>
        <default applyOnUpdate="0" expression="''" field="poi_beschreibung"/>
        <default applyOnUpdate="1" expression="if(&quot;adresse&quot; is NULL, &#xa;&#x9;&#x9;concat(adr_osm('add'), ', ' ,adr_osm('plz'), ' ' ,adr_osm('cit'))&#xa;&#x9;&#x9;, &quot;adresse&quot; &#xa;&#x9;&#x9;)" field="adresse"/>
        <default applyOnUpdate="1" expression="round($x)" field="xc"/>

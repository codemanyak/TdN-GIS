              <default applyOnUpdate="1" expression="if( &quot;name&quot; is NULL or &quot;name&quot; = '' ,&#xd;&#xa;case&#xd;&#xa;when  &quot;typ&quot; =  '5 Stop'  &#xd;&#xa;then &#xd;&#xa;&#x9;('S ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '5 Stop' ),0),0) +1) &#xd;&#xa;&#x9;&#x9;&#x9;) &#xd;&#xa;when&quot;typ&quot; =  '4 Überhol' &#xd;&#xa;then &#xd;&#xa;&#x9;('Ü ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '4 Überhol' ),0),0) +1)  &#xd;&#xa;&#x9;&#x9;&#x9;)&#xd;&#xa;&#xd;&#xa;else ''&#xd;&#xa;end,&#xd;&#xa;&quot;name&quot;&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;" field="name"/>

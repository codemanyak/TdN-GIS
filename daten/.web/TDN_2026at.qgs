            <defaults>
              <default expression="" field="fid" applyOnUpdate="0"/>
              <default expression=" concat(&quot;etappe&quot; ,&#xa;&#x9;&#x9;&#x9; (if(  &quot;typ&quot; = '4 Sonder' ,' S: ','')),&#xa;&#x9;&#x9;&#x9;( if(&quot;etappen_segment&quot; is not NULL,('/' ||&quot;etappen_segment&quot;),'') ) ,&#xa;&#x9;&#x9;&#x9;': ', &quot;start_punkt&quot; ,&#xa;&#x9;&#x9;&#x9;' => ' ||  &quot;ziel_punkt&quot; &#xa;&#x9;&#x9;&#x9;)" field="name" applyOnUpdate="1"/>
              <default expression="" field="etappe" applyOnUpdate="0"/>
              <default expression="" field="etappen_bezeichnung" applyOnUpdate="0"/>
              <default expression="if( &quot;etappe&quot; = 2,  &quot;name&quot; ,&#xa;with_variable('ob',&#xa;&#x9; get_feature( 'TagesStrecken', 'bezeichnung' ,&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;attribute(@feature,'etappen_bezeichnung' )&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;),&#xa;concat(&#xa;&#x9; &quot;etappe&quot; , ': ' ,&#xa;&#x9;attribute(@ob,'start_punkt' ) , ' => ' ,&#xa;&#x9;attribute(@ob,'ziel_punkt' ) &#xa;&#x9;)&#xa;&#x9;)&#xa;&#x9;)" field="etappen_name" applyOnUpdate="1"/>
              <default expression="" field="datum" applyOnUpdate="0"/>
              <default expression="" field="wochentag" applyOnUpdate="0"/>
              <default expression="with_variable('ms',maximum(&quot;etappen_segment&quot; ,group_by:=  &quot;etappe&quot; ||  &quot;sonder&quot; ),&#xa;Case &#xa;&#xa;&#x9;when regexp_substr(&quot;fid&quot; ,'[a-z]') = '' then &quot;etappen_segment&quot;&#xa;&#x9;when  &quot;etapen_typ&quot; =  '1 Start'  then 1&#xa;&#x9;when @ms is not NULL &#xa;&#x9;&#x9;and &quot;etappen_segment&quot; = 1&#xa;&#x9;&#x9;then @ms  + 1&#xa;&#x9;when @ms is NULL then  1&#xa;&#x9;else @ms  + 1&#xa;&#x9;end&#xa;&#x9;&#x9;&#x9;&#x9;&#xa;&#x9;&#x9;&#x9;)" field="etappen_segment" applyOnUpdate="1"/>
              <default expression="" field="start_punkt" applyOnUpdate="0"/>
              <default expression="" field="ziel_punkt" applyOnUpdate="0"/>
              <default expression="NULL" field="etapen_typ" applyOnUpdate="0"/>
              <default expression="round($length / 1000,3)" field="strecke_km" applyOnUpdate="1"/>
              <default expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'hut')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;" field="hut" applyOnUpdate="1"/>
              <default expression="NULL" field="status" applyOnUpdate="0"/>
              <default expression="''" field="aufgaben" applyOnUpdate="0"/>
              <default expression="''" field="bemerkungen" applyOnUpdate="0"/>
              <default expression="" field="bearb_von" applyOnUpdate="0"/>
              <default expression="format_date(  now(),'yyyy-MM-dd')" field="bearb_am" applyOnUpdate="1"/>
              <default expression="if(  &quot;typ&quot; = '4 Sonder' ,1,0)" field="sonder" applyOnUpdate="1"/>
              <default expression="" field="zeit" applyOnUpdate="0"/>
              <default expression="" field="aktion" applyOnUpdate="0"/>
              <default expression="round(((($length / 1000 ) / 8) * 60))" field="kmh_08_min" applyOnUpdate="1"/>
              <default expression="round(((($length / 1000 ) / 10) * 60))" field="kmh_10_min" applyOnUpdate="0"/>
              <default expression="round(((($length / 1000 ) / 12) * 60))" field="kmh_12_min" applyOnUpdate="1"/>
              <default expression="round(((($length / 1000 ) / 15) * 60))" field="kmh_15_min" applyOnUpdate="1"/>
            </defaults>

      <defaults>
        <default expression="" field="fid" applyOnUpdate="0"/>
        <default expression="NULL" field="typ" applyOnUpdate="0"/>
        <default expression="if( &quot;name&quot; is NULL or &quot;name&quot; = '' ,&#xd;&#xa;case&#xd;&#xa;when  &quot;typ&quot; =  '5 Stop'  &#xd;&#xa;then &#xd;&#xa;&#x9;('S ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '5 Stop' ),0),0) +1) &#xd;&#xa;&#x9;&#x9;&#x9;) &#xd;&#xa;when&quot;typ&quot; =  '4 Überhol' &#xd;&#xa;then &#xd;&#xa;&#x9;('Ü ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '4 Überhol' ),0),0) +1)  &#xd;&#xa;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;&#xa;&#xa;when  &quot;typ&quot; in ( '1 Quartier' , '2 Mittag' , '3 Aktion' ) then adr_osm('cit') || ' **Bitte ergänzen***'&#xd;&#xa;&#xd;&#xa;else ''&#xd;&#xa;end,&#xd;&#xa;&quot;name&quot;&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;" field="name" applyOnUpdate="1"/>
        <default expression="if( &quot;bearbeitet_von&quot;  is NULL or &quot;bearbeitet_von&quot; = '',&#xa;attribute(&#xa; get_feature( 'Akteure','akt_us','1'),&#xa; 'name')&#xa; , &quot;bearbeitet_von&quot; )" field="bearbeitet_von" applyOnUpdate="1"/>
        <default expression="" field="datum_aenderung" applyOnUpdate="0"/>
        <default expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'hut_quartier')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;" field="hut" applyOnUpdate="1"/>
        <default expression="" field="etappen_bezeichnung" applyOnUpdate="0"/>
        <default expression=" attribute(&#xa; get_feature('Etappen','bezeichnung', &quot;etappen_bezeichnung&quot; ),'etappe')" field="etappe" applyOnUpdate="1"/>
        <default expression="attribute(&#x9;&#xa;&#x9; get_feature( 'StreckenPlan', 'etappen_bezeichnung' , &quot;etappen_bezeichnung&quot; ),&#xa;&#x9; 'etappen_name' )&#xa;" field="etappen_name" applyOnUpdate="1"/>
        <default expression="attribute(&#xa;get_feature('Etappen','bezeichnung',&#xa;&#x9;&#x9;&#x9;attribute(@feature, 'etappen_bezeichnung' )),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'datum')&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;" field="datum" applyOnUpdate="1"/>
        <default expression=" attribute(&#xa; get_feature('Etappen','bezeichnung', &quot;etappen_bezeichnung&quot; ),'wochentag')" field="wochentag" applyOnUpdate="1"/>
        <default expression="'7 Keines'" field="quartiertyp" applyOnUpdate="0"/>
        <default expression="''" field="quartier_beschreibung" applyOnUpdate="0"/>
        <default expression="0" field="anzahl_dusche" applyOnUpdate="0"/>
        <default expression="1" field="anzahl_klo" applyOnUpdate="0"/>
        <default expression="" field="zelt" applyOnUpdate="0"/>
        <default expression="0" field="ab_raeume" applyOnUpdate="0"/>
        <default expression="0" field="telefon" applyOnUpdate="0"/>
        <default expression="0" field="internet" applyOnUpdate="0"/>
        <default expression="case&#xa;when  &quot;typ&quot; in ( '1 Quartier' , '2 Mittag' , '3 Aktion' ) then &quot;status&quot;&#xa;when &quot;typ&quot; in (  '4 Überhol' ,  '5 Stop' ) then '5 STOP-Überhol'&#xa;when &quot;typ&quot; =  '6 POI' then '4 POI'&#xa;end" field="status" applyOnUpdate="1"/>
        <default expression="0" field="kosten" applyOnUpdate="0"/>
        <default expression="''" field="kosten_beschr" applyOnUpdate="0"/>
        <default expression="''" field="bedingungen" applyOnUpdate="0"/>
        <default expression="" field="aktion_typ" applyOnUpdate="0"/>
        <default expression="''" field="aktion_beschreibung" applyOnUpdate="0"/>
        <default expression="'12 Sonstiges' " field="poi_typ" applyOnUpdate="0"/>
        <default expression="''" field="poi_beschreibung" applyOnUpdate="0"/>
        <default expression="if(&quot;adresse&quot; is NULL, &#xa;&#x9;&#x9;concat(adr_osm('add'), ', ' ,adr_osm('plz'), ' ' ,adr_osm('cit'))&#xa;&#x9;&#x9;, &quot;adresse&quot; &#xa;&#x9;&#x9;)" field="adresse" applyOnUpdate="1"/>
        <default expression="round($x)" field="xc" applyOnUpdate="1"/>
        <default expression="round($y)" field="yc" applyOnUpdate="1"/>
        <default expression="''" field="bemerkungen" applyOnUpdate="0"/>
        <default expression="''" field="aufgaben" applyOnUpdate="0"/>
        <default expression="''" field="k_name" applyOnUpdate="0"/>
        <default expression="''" field="k_rolle" applyOnUpdate="0"/>
        <default expression="''" field="k_bemerkung" applyOnUpdate="0"/>
        <default expression="''" field="k_adresse" applyOnUpdate="0"/>
        <default expression="''" field="k_telefon" applyOnUpdate="0"/>
        <default expression="''" field="k_tel_2" applyOnUpdate="0"/>
        <default expression="''" field="k_mail" applyOnUpdate="0"/>
        <default expression="0" field="k_hauptkontakt" applyOnUpdate="0"/>
        <default expression="" field="folge" applyOnUpdate="0"/>
        <default expression="" field="abgesagt" applyOnUpdate="0"/>
        <default expression="" field="ankunft" applyOnUpdate="0"/>
        <default expression="" field="abfahrt" applyOnUpdate="0"/>
        <default expression="0.0" field="km" applyOnUpdate="0"/>
        <default expression="0" field="nur_fuer_bes_faelle" applyOnUpdate="0"/>
        <default expression="/*&#xa;case&#xa;&#x9;when   &quot;typ&quot;  =  '1 Quartier' &#xa;&#x9;&#x9; then attribute( &#xa;&#x9;&#x9;&#x9;&#x9;get_feature( 'Etappen', 'nr' , &quot;etappe&quot; +  &quot;aufenthalt_tage&quot; ),&#xa;&#x9;&#x9;&#x9;&#x9;&#x9; 'bezeichnung' &#xa;&#x9;&#x9;&#x9;&#x9;&#x9; )&#xa;&#x9;Else  &quot;etappen_bezeichnung&quot; &#xa;end&#xa;*/&#xa;''" field="abfahrt_tag" applyOnUpdate="0"/>
        <default expression="&#xa;case&#xa;&#x9;when right( &quot;etappen_bezeichnung&quot; ,2) = right(&quot;abfahrt_tag&quot; ,2)&#xa;&#x9;then &#xa;&#x9;&#x9;&#x9;substr(right(&quot;abfahrt_tag&quot; ,5),1,2) &#xa;&#x9;&#x9;- substr(right(&quot;etappen_bezeichnung&quot; ,5),1,2) &#xa;&#x9;else &#xa;&#x9;   substr(right(&quot;abfahrt_tag&quot; ,5),1,2)  &#xa;&#x9;   + (31 - substr(right(&quot;etappen_bezeichnung&quot; ,5),1,2) )&#xa;end&#xa;&#x9;&#x9;&#xa;" field="aufenthalt_tage" applyOnUpdate="1"/>
        <default expression="" field="xxc" applyOnUpdate="0"/>
        <default expression="" field="yyc" applyOnUpdate="0"/>
      </defaults>

                  <Option value="3" type="int" name="type"/>
                </Option>
                <Option type="Map" name="Size">
                  <Option value="true" type="bool" name="active"/>
                  <Option value="case &#xa;when   @map_scale  &lt; 8000 then&#xa;(case&#xa;when    &quot;ha_strasse&quot; = 1 and  &quot;bundesstrasse&quot; = 0 then 8&#xa;when  &quot;bundesstrasse&quot; = 1 then 10&#xa;else 7&#xa;end)&#xa;when  @map_scale  >= 8001 then&#xa;(case&#xa;when   &quot;ha_strasse&quot; = 1 then 6&#xa;else 4&#xa;end&#xa;)&#xa;end" type="QString" name="expression"/>
                  <Option value="3" type="int" name="type"/>
                </Option>

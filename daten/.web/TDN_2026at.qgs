                  <Option value="case&#xa;when  &quot;bundesstrasse&quot; = 1 then 10&#xa;when   &quot;landesstrasse&quot; = 1 then 8&#xa;when   &quot;kreisstrasse&quot; = 1 then 6&#xa;else 4&#xa;end" type="QString" name="expression"/>
                  <Option value="3" type="int" name="type"/>
                </Option>
                <Option type="Map" name="Priority">

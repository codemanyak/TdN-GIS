                <rule symbol="1" key="{cd84d151-e3f1-4374-bc6b-64c70d150753}" label="Planung" filter=" &quot;status&quot; =  '1 Entwurf' --aggregate( 'Punkte',aggregate:= 'concatenate_unique',expression:= &quot;status&quot;,filter:=   &quot;name&quot; in ( attribute(@parent, 'start_punkt'),attribute(@parent,       'ziel_punkt')),concatenator:=',')  != '3 Bestätigt' or &quot;status&quot; != '3 Genehmigt' " checkstate="0"/>

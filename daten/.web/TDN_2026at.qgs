              <default expression="if( &quot;name&quot; is NULL or &quot;name&quot; = '' ,&#xd;&#xa;case&#xd;&#xa;when  &quot;typ&quot; =  '5 Stop'  &#xd;&#xa;then &#xd;&#xa;&#x9;('S ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '5 Stop' ),0),0) +1) &#xd;&#xa;&#x9;&#x9;&#x9;) &#xd;&#xa;when&quot;typ&quot; =  '4 Überhol' &#xd;&#xa;then &#xd;&#xa;&#x9;('Ü ' ||  to_string(&quot;etappe&quot;) ||'/' || &#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(coalesce(maximum(coalesce(regexp_substr(&quot;name&quot;,'[0-9]+$'),&quot;etappe&quot;,&quot;typ&quot; = '4 Überhol' ),0),0) +1)  &#xd;&#xa;&#x9;&#x9;&#x9;)&#xd;&#xa;&#xd;&#xa;else ''&#xd;&#xa;end,&#xd;&#xa;&quot;name&quot;&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;" field="name" applyOnUpdate="1"/>
              <default expression="if( &quot;bearbeitet_von&quot;  is NULL or &quot;bearbeitet_von&quot; = '',&#xa;attribute(&#xa; get_feature( 'Akteure','akt_us','1'),&#xa; 'name')&#xa; , &quot;bearbeitet_von&quot; )" field="bearbeitet_von" applyOnUpdate="0"/>
              <default expression="" field="datum_aenderung" applyOnUpdate="0"/>

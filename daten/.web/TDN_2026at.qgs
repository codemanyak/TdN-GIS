                    <Option value="" type="QString" name="name"/>
                    <Option type="Map" name="properties">
                      <Option type="Map" name="Bold">
                        <Option value="true" type="bool" name="active"/>
                        <Option value="case&#xa;when   &quot;ha_strasse&quot; = 1 &#xa;and  @map_scale  &lt; 30000 then 'true'&#xa;end" type="QString" name="expression"/>
                        <Option value="3" type="int" name="type"/>
                      </Option>
                      <Option type="Map" name="FontSizeUnit">
                        <Option value="true" type="bool" name="active"/>
                        <Option value="case&#xa;when  @map_scale > 6000 then 'Points'&#xa;else 'MapUnit'&#xa;end" type="QString" name="expression"/>
                        <Option value="3" type="int" name="type"/>
                      </Option>
                      <Option type="Map" name="MinimumScale">
                        <Option value="true" type="bool" name="active"/>
                        <Option value="case&#xa; when  @map_scale  > 7000 and  (&quot;ha_strasse&quot; = 1 or   &quot;autobahn&quot; = 1) then  70000&#xa; end" type="QString" name="expression"/>
                        <Option value="3" type="int" name="type"/>
                      </Option>
                      <Option type="Map" name="ObstacleFactor">
                        <Option value="true" type="bool" name="active"/>
                        <Option value="case&#xa;when  &quot;bundesstrasse&quot; = 1 then 10&#xa;when   &quot;landesstrasse&quot; = 1 then 8&#xa;when   &quot;kreisstrasse&quot; = 1 then 6&#xa;else 4&#xa;end" type="QString" name="expression"/>
                        <Option value="3" type="int" name="type"/>
                      </Option>
                      <Option type="Map" name="PositionX">
                        <Option value="false" type="bool" name="active"/>
